# DAAI API beta environment template.
# Safe to commit. Copy values into Cloud Run or Secret Manager; do not store real secrets here.

# Public beta URLs
DAAI_PUBLIC_BASE_URL=http://127.0.0.1:8000
DAAI_DASHBOARD_BASE_URL=http://localhost:3000
DAAI_CORS_ORIGINS=http://localhost:3000
DAAI_ADMIN_EMAILS=sany.alam.au@gmail.com

# New beta Supabase project only
DAAI_DATABASE_URL=<new_beta_supabase_database_connection_string>
DAAI_SUPABASE_URL=<new_beta_supabase_project_url>
DAAI_SUPABASE_JWT_SECRET=<new_beta_supabase_jwt_secret_or_secret_key_for_auth_fallback>

# Security peppers
DAAI_API_KEY_PEPPER=<new_beta_random_pepper>
DAAI_WORKSPACE_KEY_PEPPER=<new_beta_random_pepper>
DAAI_APPROVAL_TOKEN_PEPPER=<new_beta_random_pepper>
DAAI_APPROVAL_TOKEN_TTL_SECONDS=86400

# Approval email
DAAI_APPROVAL_EMAIL_PROVIDER=resend
DAAI_APPROVAL_EMAIL_FROM=DAAI Console <approval@daaihq.com>
DAAI_RESEND_API_KEY=<new_or_approved_beta_resend_api_key>

# Optional setup-time policy suggestions
DAAI_OPEN_AI_API_KEY=<optional_server_side_openai_key>
DAAI_POLICY_MODEL=gpt-5.4-mini

# Production safety
DAAI_DEV_APPROVAL_LINK_LOGGING_ENABLED=false
DAAI_DEV_AUTO_LINK_SEEDED_WORKSPACE=false
